# Copy to ".env.local" and fill in. NEVER commit .env.local (it is in .gitignore).

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=gig_marketplace

# --- Login sessions: any long random string, 32+ characters ---
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# --- Vector search service (the Python/FastAPI app in ../vector) ---
VECTOR_API_URL=http://127.0.0.1:8000
VECTOR_API_KEY=pick-any-shared-secret-and-use-the-same-in-vector-.env
