# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=gig_marketplace
CHROMA_PATH=./chroma_data

# Shared secret between the Next.js app and this service. Use the SAME value in web/.env.local
VECTOR_API_KEY=pick-any-shared-secret-and-use-the-same-in-vector-.env
